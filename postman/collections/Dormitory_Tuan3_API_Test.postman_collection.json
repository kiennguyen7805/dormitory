{
  "info": {
    "_postman_id": "c82d25f9-02ec-4de0-b25e-a3dc4e420003",
    "name": "Dormitory - Tuần 3 (F12 - F16)",
    "description": "Kiểm thử biểu giá, công tơ, chỉ số, Excel và hóa đơn tuần 3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
  "item": [
    {
      "name": "01. Login Admin",
      "auth": { "type": "noauth" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
        "pm.environment.set('adminToken', pm.response.json().access_token);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@dormitory.local\",\n  \"password\": \"Admin@123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "02. Lấy catalog điện nước",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Có catalog điện nước', () => pm.response.to.have.status(200));",
        "const rows = pm.response.json();",
        "pm.environment.set('electricityId', rows.find(x => x.code === 'ELECTRICITY').id);"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/utilities" }
    },
    {
      "name": "03. Lấy phòng đầu tiên",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Có phòng để gắn công tơ', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).above(0); });",
        "pm.environment.set('roomId', pm.response.json()[0].id);"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/rooms" }
    },
    {
      "name": "04. Tạo biểu giá điện hai bậc",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Tạo biểu giá', () => pm.response.to.have.status(201));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"utility_id\": \"{{electricityId}}\",\n  \"name\": \"Biểu giá điện tuần 3\",\n  \"effective_from\": \"2026-09-01\",\n  \"calculation_type\": \"Tiered\",\n  \"tiers\": [\n    {\"tier_order\": 1, \"from_quantity\": 0, \"to_quantity\": 50, \"unit_price\": 1000},\n    {\"tier_order\": 2, \"from_quantity\": 50, \"to_quantity\": null, \"unit_price\": 2000}\n  ]\n}" },
        "url": "{{baseUrl}}/utility-tariffs"
      }
    },
    {
      "name": "05. Xem biểu giá",
      "request": { "method": "GET", "url": "{{baseUrl}}/utility-tariffs" }
    },
    {
      "name": "06. Tạo công tơ",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Tạo công tơ', () => pm.response.to.have.status(201));",
        "pm.environment.set('meterId', pm.response.json().id);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"utility_id\": \"{{electricityId}}\",\n  \"room_id\": \"{{roomId}}\",\n  \"meter_code\": \"DIEN-POSTMAN-W3\",\n  \"initial_reading\": 0\n}" },
        "url": "{{baseUrl}}/meters"
      }
    },
    {
      "name": "07. Ghi chỉ số thủ công",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Tính đúng tiền hai bậc', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().calculated_amount).eql('110000.00'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"meter_id\": \"{{meterId}}\",\n  \"period_start\": \"2026-09-01\",\n  \"period_end\": \"2026-09-30\",\n  \"previous_reading\": 0,\n  \"current_reading\": 80\n}" },
        "url": "{{baseUrl}}/meter-readings"
      }
    },
    {
      "name": "08. Tải mẫu Excel",
      "request": { "method": "GET", "url": "{{baseUrl}}/meter-readings/template" }
    },
    {
      "name": "09. Xem trước Excel (chọn file thủ công)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "if (pm.response.code === 200) pm.environment.set('batchId', pm.response.json().batch_id);"
      ] } }],
      "request": {
        "method": "POST",
        "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
        "url": "{{baseUrl}}/meter-readings/import/preview"
      }
    },
    {
      "name": "10. Xác nhận nhập Excel",
      "request": { "method": "POST", "url": "{{baseUrl}}/meter-readings/import/{{batchId}}/confirm" }
    },
    {
      "name": "11. Sinh hóa đơn idempotent",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"contract_id\": \"{{contractId}}\",\n  \"period_start\": \"2026-09-01\",\n  \"period_end\": \"2026-09-30\",\n  \"issued_date\": \"2026-10-01\",\n  \"due_date\": \"2026-10-10\",\n  \"idempotency_key\": \"postman-week3-september-2026\"\n}" },
        "url": "{{baseUrl}}/bills/generate"
      }
    }
  ]
}

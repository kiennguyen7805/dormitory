        {
          "name": "5.2 Kiểm tra Room Matrix (T2-11)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var targetId = pm.environment.get(\"bed1Id\");",
                  "var allBeds = pm.response.json()",
                  "    .flatMap(function(building) { return building.rooms; })",
                  "    .flatMap(function(room) { return room.beds; });",
                  "var target = allBeds.find(function(bed) { return bed.id === targetId; });",
                  "pm.test(\"Giường 1 chuyển sang Occupied\", function () {",
                  "    pm.expect(target).to.exist;",
                  "    pm.expect(target.status).to.eql(\"Occupied\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {

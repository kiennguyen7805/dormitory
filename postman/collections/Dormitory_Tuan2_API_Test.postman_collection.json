              "script": {
                "exec": [
                  "var ids = [pm.environment.get(\"bed1Id\"), pm.environment.get(\"bed2Id\")];",
                  "var allBeds = pm.response.json()",
                  "    .flatMap(function(building) { return building.rooms; })",
                  "    .flatMap(function(room) { return room.beds; });",
                  "var selected = allBeds.filter(function(bed) { return ids.includes(bed.id); });",
                  "pm.test(\"Cả hai giường đã được giải phóng thành Available\", function () {",
                  "    pm.expect(selected).to.have.length(2);",
                  "    selected.forEach(function(bed) {",
                  "        pm.expect(bed.status).to.eql(\"Available\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }

          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Có tối thiểu hai giường trống\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var available = pm.response.json().filter(function(item) {",

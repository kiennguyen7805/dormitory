    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Always resolve variables from this collection, even if another environment was selected.",
          "pm.collectionVariables.toObject && Object.entries(pm.collectionVariables.toObject()).forEach(([k,v])=>pm.variables.set(k,v));"
        ]
      }
    }

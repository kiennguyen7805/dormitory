              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(pm.response.text()); }",
                  "const token = pm.response.json().access_token; pm.expect(token).to.be.a('string').and.not.empty; pm.collectionVariables.set('adminToken', token); pm.collectionVariables.set('access_token', token);"

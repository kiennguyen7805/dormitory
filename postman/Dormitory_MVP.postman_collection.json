    {
      "name": "04 - Hóa đơn và thanh toán",
      "item": [
        {
          "name": "Tạo hóa đơn phòng",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bills/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": \"{{roomId}}\",\n  \"period_start\": \"{{today}}\",\n  \"period_end\": \"{{periodEnd}}\",\n  \"issued_date\": \"{{today}}\",\n  \"due_date\": \"{{dueDate}}\",\n  \"idempotency_key\": \"{{billKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const b=pm.response.json(); pm.collectionVariables.set('billId',b.id); pm.test('Hóa đơn có hai khoản tiện ích',()=>pm.expect(b.items).to.have.length(2)); pm.test('Tổng tiền lớn hơn 0',()=>pm.expect(b.total_amount).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sinh viên xem chi tiết hóa đơn",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bills/{{billId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [

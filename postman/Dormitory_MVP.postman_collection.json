                  "const rows=pm.response.json(); const today=pm.collectionVariables.get('today'); const found=rows.find(x=>x.effective_from<=today && (!x.effective_to || x.effective_to>=today)); if(found) pm.collectionVariables.set(pm.variables.get(''electricityTariffId''),found.id);"
                ]
              }
            }
          ]
        },
